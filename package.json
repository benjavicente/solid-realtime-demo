{
  "name": "solid-realtime-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "deploy": "cf deploy"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.21",
    "@stylexjs/stylex": "^0.18.1",
    "solid-js": "2.0.0-rc.21"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "@solidjs/diagnostics": "2.0.0-rc.21",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@stylexjs/unplugin": "^0.18.1",
    "@types/node": "^24.0.0",
    "cf": "1.0.0-beta.32",
    "eslint-plugin-solid": "^0.19.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
